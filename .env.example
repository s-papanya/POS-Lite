# API (loaded from the repository root)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local PostgreSQL only. Replace before starting Compose; never commit .env.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=replace-with-local-random-password

# Local commands only: separate migration admin and restricted runtime identity.
# Use the same POSTGRES_PASSWORD in the admin URL (URL-encode special characters).
# Generate a separate hex password of at least 48 characters for pos_lite_app.
MIGRATION_DATABASE_URL=postgresql://pos_lite_local:replace-with-local-random-password@127.0.0.1:5433/pos_lite_dev
DATABASE_URL=postgresql://pos_lite_app:replace-with-64-hex-characters@127.0.0.1:5433/pos_lite_dev
APP_ORIGIN=http://localhost:5173
# Generate at least 64 hex characters. Required by the API; never expose via VITE_*.
SESSION_SECRET=replace-with-64-hex-characters

# Development seed only; 12–128 characters, distinct usernames. Reruns do not reset passwords.
SEED_OWNER_USERNAME=dev-owner
SEED_OWNER_PASSWORD=replace-with-generated-password
SEED_MOTHER_USERNAME=dev-mother
SEED_MOTHER_PASSWORD=replace-with-another-generated-password
